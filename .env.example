# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Single-church deployment: defaults to Demo Church (canonical ID below).
# Override only when provisioning a separate single-church database/deployment.
VITE_CHURCH_ID=00000000-0000-0000-0000-000000000001

# Gemini AI (used via Supabase Edge Function)
VITE_GEMINI_API_KEY=placeholder-api-key

# Optional: Stripe for billing integration
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
